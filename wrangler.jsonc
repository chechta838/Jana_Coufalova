// Cloudflare Workers: web ze složky _site + přihlášení do administrace (cloudflare-auth/worker.js)
{
  "name": "jana-coufalova",
  "main": "cloudflare-auth/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./_site",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
